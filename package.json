{
  "name": "vscode-theme-fullmetal",
  "displayName": "Fullmetal Theme",
  "version": "2.3.0",
  "description": "A dark theme with vibrant colors crafted with alchemy.",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "color-theme",
    "dark",
    "fullmetal",
    "theme"
  ],
  "homepage": "https://github.com/DanielHZhang/vscode-theme-fullmetal",
  "bugs": "https://github.com/DanielHZhang/vscode-theme-fullmetal/issues",
  "license": "MIT",
  "author": "Daniel Zhang",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielHZhang/vscode-theme-fullmetal"
  },
  "publisher": "DanielZhang",
  "files": [
    "build/vscode/extension.js",
    "build/vscode/schema-names.js",
    "themes/fullmetal-theme-vscode.json",
    "syntaxes/dotenv.injection.tmLanguage.json",
    "assets/logo.png",
    "license.md"
  ],
  "type": "module",
  "main": "build/vscode/extension.js",
  "browser": "build/vscode/extension.js",
  "scripts": {
    "generate-types": "node --experimental-strip-types src/scripts/generate-types.ts",
    "update-vscode-schemas": "pnpm exec tsc --incremental false && node --experimental-strip-types src/scripts/update-vscode-schemas.ts",
    "generate-theme": "node --experimental-strip-types src/scripts/generate-theme.ts",
    "release": "bash .github/scripts/dispatch-release.sh",
    "vscode:publish": "pnpm exec vsce package --no-dependencies",
    "vscode:prepublish": "pnpm exec tsc --incremental false && pnpm run generate-theme",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.1.0",
    "json-schema-to-typescript-lite": "15.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2005",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "dotenv",
        "extensions": [
          ".flaskenv",
          ".env-sample",
          ".env.example",
          ".env.local",
          ".env.dev",
          ".env.dev.local",
          ".env.build",
          ".env.build.local",
          ".env.development",
          ".env.development.local",
          ".env.test",
          ".env.test.local",
          ".env.testing",
          ".env.qa",
          ".env.qa.local",
          ".env.uat",
          ".env.uat.local",
          ".env.stag",
          ".env.stag.local",
          ".env.stage",
          ".env.stage.local",
          ".env.staging",
          ".env.staging.local",
          ".env.live",
          ".env.live.local",
          ".env.production",
          ".env.production.local",
          ".env.prod",
          ".env.prod.local"
        ]
      }
    ],
    "grammars": [
      {
        "scopeName": "fullmetal.dotenv.injection",
        "injectTo": [
          "source.dotenv"
        ],
        "path": "./syntaxes/dotenv.injection.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "saveBuiltInSchemas",
        "title": "Save Built-in VSCode Theme Schemas",
        "category": "Fullmetal"
      }
    ],
    "themes": [
      {
        "label": "Fullmetal",
        "path": "./themes/fullmetal-theme-vscode.json",
        "uiTheme": "vs-dark"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "assets/logo.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
