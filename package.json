{
  "name": "vscode-theme-fullmetal",
  "displayName": "Fullmetal Theme",
  "version": "2.0.0",
  "description": "A dark theme with vibrant colors crafted with alchemy.",
  "license": "MIT",
  "type": "module",
  "publisher": "DanielZhang",
  "author": "Daniel Zhang",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielHZhang/vscode-theme-fullmetal"
  },
  "homepage": "https://github.com/DanielHZhang/vscode-theme-fullmetal",
  "bugs": "https://github.com/DanielHZhang/vscode-theme-fullmetal/issues",
  "scripts": {
    "generate-types": "node --experimental-strip-types src/scripts/generate-types.ts",
    "update-vscode-schemas": "pnpm exec tsc --incremental false && node --experimental-strip-types src/scripts/update-vscode-schemas.ts",
    "generate-theme": "node --experimental-strip-types src/scripts/generate-theme.ts",
    "release": "bash .github/scripts/dispatch-release.sh",
    "vscode:publish": "pnpm exec vsce package --no-dependencies",
    "vscode:prepublish": "pnpm exec tsc --incremental false && pnpm run generate-theme",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "json-schema-to-typescript-lite": "15.0.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "main": "build/vscode/extension.js",
  "browser": "build/vscode/extension.js",
  "icon": "assets/logo.png",
  "files": [
    "build/vscode/extension.js",
    "build/vscode/schema-names.js",
    "themes/fullmetal-theme-vscode.json",
    "assets/logo.png",
    "license.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "saveBuiltInSchemas",
        "title": "Save Built-in VSCode Theme Schemas",
        "category": "Fullmetal"
      }
    ],
    "themes": [
      {
        "label": "Fullmetal",
        "path": "./themes/fullmetal-theme-vscode.json",
        "uiTheme": "vs-dark"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "color-theme",
    "dark",
    "fullmetal",
    "theme"
  ]
}
